# Keep LF in every checkout, including Windows (core.autocrlf=true on the GitHub Windows runners),
# so hashes, fixtures and desktop tooling see the same bytes on every OS.
* text=auto eol=lf
*.png binary
*.ico binary
*.icns binary
*.tgz binary
*.node binary
# Vendored file committed with CRLF; keep its bytes as they are.
backend/tools/fulfillment/shipping-label-source/MIT-LICENSE.txt -text

{
  "name": "@pos/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc -p electron/tsconfig.json",
    "build": "npm run typecheck && vite build && vite build --config electron/vite.config.ts",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "desktop": "vite build --config electron/vite.config.ts && electron .",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder",
    "lint": "eslint src tests e2e vite.config.ts playwright.config.ts vitest.config.ts",
    "desktop:pack:mac": "npm run build && electron-builder --mac --dir",
    "desktop:pack:win": "npm run build && electron-builder --win --x64 --dir",
    "desktop:dist:mac": "npm run build && electron-builder --mac --x64 --arm64",
    "desktop:dist:win": "npm run build && electron-builder --win --x64",
    "verify:dependency-security": "node tools/dependency-security/verify.mjs",
    "prebuild": "node tools/dependency-security/verify.mjs",
    "predev": "node tools/dependency-security/verify.mjs",
    "pretest": "node tools/dependency-security/verify.mjs",
    "prelint": "node tools/dependency-security/verify.mjs",
    "pretypecheck": "node tools/dependency-security/verify.mjs",
    "pretest:e2e": "node tools/dependency-security/verify.mjs",
    "prepreview": "node tools/dependency-security/verify.mjs"
  },
  "build": {
    "appId": "com.thesouledstore.pos",
    "productName": "Souled POS",
    "beforePack": "./electron/before-pack.cjs",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/offline/**/*",
      "!electron/vite.config.ts",
      "!electron/tsconfig.json",
      "package.json",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "node_modules/better-sqlite3-multiple-ciphers",
        "to": "offline-sqlite",
        "filter": [
          "package.json",
          "LICENSE",
          "lib/**/*",
          "prebuilds/${platform}-${arch}.node"
        ]
      }
    ],
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "category": "public.app-category.business"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": false,
      "resetAdHocDarwinSignature": true
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "dexie": "4.4.7",
    "lucide-react": "1.73.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "zod": "4.6.7",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "eslint": "10.15.0",
    "fake-indexeddb": "6.2.8",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "picomatch": "file:tools/dependency-security/picomatch-4.0.7-pos-review.tgz"
  },
  "overrides": {
    "minimatch": "11.0.1",
    "picomatch": "$picomatch"
  },
  "description": "Souled Store retail workspace for web, Windows and macOS",
  "author": "The Souled Store"
}

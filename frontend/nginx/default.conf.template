server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  client_max_body_size 256k;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy same-origin always;
  add_header X-Frame-Options SAMEORIGIN always;

  location = /health/static { access_log off; return 200 'ok'; }
  location ~ ^/(api|health)/ {
    proxy_pass http://${API_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_connect_timeout 5s;
    proxy_read_timeout 65s;
    proxy_send_timeout 15s;
    proxy_buffering off;
    proxy_cache off;
  }
  location = /service-worker.js { add_header Cache-Control 'no-cache'; try_files $uri =404; }
  location = /index.html { add_header Cache-Control 'no-cache'; try_files $uri =404; }
  location /assets/ { add_header Cache-Control 'public,max-age=31536000,immutable'; try_files $uri =404; }
  location / { try_files $uri $uri/ /index.html; }
}

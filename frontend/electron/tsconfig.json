{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": true,
    "types": ["node"],
    "paths": {
      "better-sqlite3-multiple-ciphers": ["../node_modules/better-sqlite3-multiple-ciphers/index.d.ts"]
    }
  },
  "include": [
    "offline/**/*.ts",
    "vite.config.ts",
    "../src/offline/billing/**/*.ts",
    "main.cjs",
    "preload.cjs",
    "workspace-config.cjs",
    "runtime-mode.cjs"
  ]
}

{
  "name": "@pos/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch --import=tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate:plan": "node dist/db/migrate.js",
    "migrate:apply": "node --env-file-if-exists=.env dist/db/migrate.js --apply",
    "worker:financial-outbox": "node --env-file-if-exists=.env dist/modules/checkout/worker.js",
    "worker:administration": "node --env-file-if-exists=.env dist/modules/administration/worker-main.js",
    "worker:gift-card-batches": "node --env-file-if-exists=.env dist/modules/gift-card-batches/worker-main.js",
    "worker:customer-contacts": "node --env-file-if-exists=.env dist/modules/customer-contacts/worker-main.js",
    "worker:customer-otp": "node --env-file-if-exists=.env dist/modules/customer-otp/worker-main.js",
    "worker:documentation-media": "node --env-file-if-exists=.env dist/modules/administration/media-worker-main.js",
    "worker:settings": "node --env-file-if-exists=.env dist/modules/administration/settings-worker-main.js",
    "worker:store-images": "node --env-file-if-exists=.env dist/modules/administration/store-image-worker-main.js",
    "verify:project": "node --import tsx tools/verify-project.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "parity:gate": "tsx tools/parity-gate.ts",
    "verify:mysql": "node tools/verify-mysql.cjs",
    "lint": "eslint src tests tools",
    "verify:dependency-security": "node tools/dependency-security/verify.mjs && node tools/dependency-security/sync-mirrors.mjs",
    "prebuild": "node tools/dependency-security/verify.mjs",
    "predev": "node tools/dependency-security/verify.mjs",
    "pretest": "node tools/dependency-security/verify.mjs",
    "prelint": "node tools/dependency-security/verify.mjs",
    "pretypecheck": "node tools/dependency-security/verify.mjs",
    "pretest:watch": "node tools/dependency-security/verify.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1169.0",
    "@aws-sdk/s3-presigned-post": "3.1169.0",
    "@aws-sdk/s3-request-presigner": "3.1169.0",
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.4.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/websocket": "11.3.7",
    "@google-cloud/bigquery": "9.6.1",
    "@js-temporal/polyfill": "0.5.1",
    "@zip.js/zip.js": "2.25.0",
    "csv-parse": "7.0.3",
    "decimal.js": "10.6.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "hashids": "2.3.0",
    "mysql2": "3.24.6",
    "otpauth": "9.6.0",
    "paytmchecksum": "1.5.1",
    "qrcode": "1.5.4",
    "redis": "6.3.1",
    "sanitize-html": "2.18.2",
    "saxes": "6.0.0",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/sanitize-html": "2.16.2",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0",
    "picomatch": "file:tools/dependency-security/picomatch-4.0.7-pos-review.tgz"
  },
  "overrides": {
    "minimatch": "11.0.1",
    "picomatch": "$picomatch"
  }
}

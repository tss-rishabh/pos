NODE_ENV=development
HOST=127.0.0.1
PORT=4410
WEB_ORIGIN=http://localhost:5173
# Comma-separated IP/CIDR addresses of the actual trusted reverse proxy only.
TRUSTED_PROXY_CIDRS=
# Local fixtures are an explicit, isolated development mode. Refused in production.
DEMO_MODE=true
SESSION_SECRET=replace-with-at-least-32-random-characters

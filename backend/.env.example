NODE_ENV=development
HOST=127.0.0.1
PORT=4410
WEB_ORIGIN=http://localhost:5173
# Comma-separated IP/CIDR addresses of the actual trusted reverse proxy only.
TRUSTED_PROXY_CIDRS=
SESSION_SECRET=replace-with-at-least-32-random-characters
# Session cookies are HttpOnly, SameSite=Lax and Secure. false only for local http; refused in production.
SESSION_COOKIE_SECURE=false
# POS authentication Redis = legacy redis_instance database 0 (sessions, login OTP state,
# check_in_* lists, auth_qr_* secrets), the job queue, locks and idempotency receipts. Required in production; rediss:// for remote hosts.
# The server MUST run with maxmemory-policy noeviction: these keys are security state
# (OTP lockouts, retry pauses, sessions) and must never be evicted.
REDIS_URL=
# Global per-client-IP request budget per minute (default 240).
API_RATE_LIMIT_PER_MINUTE=240
LOGIN_MFA_PENDING_TTL=300
LOGIN_OTP_EXPIRY=180
LOGIN_OTP_MAX_ATTEMPTS=3
LOGIN_OTP_RETRY_INTERVAL=30
LOGIN_OTP_LOCK_SECONDS=10800
LOGIN_OTP_RESEND_COOLDOWN=30
# Legacy fixed OTP for listed pos_user ids (int, stripped string, comma list of ids).
LOGIN_FIXED_OTP_ENABLED=0
LOGIN_FIXED_OTP=
LOGIN_FIXED_OTP_USER_IDS=
# live | sandbox. Sandbox records messages in memory and sends nothing; default sandbox
# outside production, refused in production.
LOGIN_OTP_DELIVERY=sandbox
# Lockout alerts; falls back to SLACK_WHATSAPP_ALERT_WEBHOOK (also used for WhatsApp failures).
LOGIN_SECURITY_SLACK_WEBHOOK=
SLACK_WHATSAPP_ALERT_WEBHOOK=
SERVICE_NAME=backend-pos-web
# Job worker slots (legacy celery --concurrency=2); promoter/heartbeat intervals in ms.
# The job queue (npm run worker:jobs) uses REDIS_URL above.
JOBS_CONCURRENCY=2
JOBS_PROMOTE_INTERVAL_MS=1000
JOBS_HEARTBEAT_INTERVAL_MS=10000
# mPOS QR sign-in uses REDIS_URL. Enable only after every device consumer uses the
# atomic verification contract.
UPSTREAM_POS_DEVICE_HANDOFF_CONTRACT=
POS_DEVICE_HANDOFF_SERVICE_KEY=
POS_AUTH_QR_EXP_SEC=60
POS_AUTH_USER_SECRET_EXP=1800
MPOS_QR_TAKE_PASSWORD=false
# Login OTP delivery; production credentials belong in a secret manager.
NETCORE_EMAIL_URL=
NETCORE_API_KEY=
GUPSHUP_SMS_USER_ID=
GUPSHUP_SMS_PASSWORD=
WHATSAPP_GUPSHUP_API_URL=
GUPSHUP_WHATSAPP_USER_ID=
GUPSHUP_WHATSAPP_PASSWORD=
BUSINESS_TIMEZONE=Asia/Kolkata
# URL-encode any reserved characters in values; use TLS on remote databases.
# MYSQL_PRIMARY_READER_URL is always required (there is no database-free mode); production
# also requires the writer and data-reader URLs. Local development uses an isolated
# loopback server with synthetic rows and MYSQL_ALLOW_LOCAL_PLAINTEXT=true.
MYSQL_WRITER_URL=
MYSQL_PRIMARY_READER_URL=
MYSQL_DATA_READER_URL=
MYSQL_TLS_CA_FILE=
MYSQL_ALLOW_LOCAL_PLAINTEXT=false
MYSQL_POOL_SIZE=8
# Google Application Default Credentials; do not put service-account JSON here.
BIGQUERY_PROJECT_ID=tssgcp2025
BIGQUERY_DATASET=tss_mysql_raw_layer
GOOGLE_APPLICATION_CREDENTIALS=
BIGQUERY_LOCATION=asia-south1
BIGQUERY_MAX_BYTES_BILLED=1000000000
# Historical NPS facts only; defaults use observed tss_* tables in this dataset.
BQ_CUSTOMER_FEEDBACK_TABLE=
BQ_CUSTOMER_FEEDBACK_ORDERS_TABLE=
BQ_CUSTOMER_FEEDBACK_ORDER_STORES_TABLE=
# Optional reviewed facts-only projection; never embed customer contacts/question text.
BQ_CUSTOMER_FEEDBACK_VIEW=
# Daily report rollups require the reviewed generation/hash/CDC publication contract.
BIGQUERY_DAILY_ROLLUP_TABLE=
BIGQUERY_DAILY_REPORT_PUBLICATIONS_TABLE=
BIGQUERY_DAILY_REPORT_OFFLINE_CONTRACT=
BIGQUERY_DAILY_REPORT_MAX_CDC_AGE_SECONDS=300
BIGQUERY_DAILY_REPORT_MAX_PUBLICATION_AGE_SECONDS=900
BIGQUERY_DAILY_REPORT_MAX_CLOCK_SKEW_SECONDS=30
# Dashboard history requires the reviewed immutable source generation and manifests.
BQ_DASHBOARD_FACTS_VIEW=
BQ_DASHBOARD_PUBLICATIONS_VIEW=
BQ_DASHBOARD_CONTRACT=
DASHBOARD_PUBLICATION_MAX_AGE_SECONDS=3600
# Historical completed imports; fully qualified verified BigQuery views.
BQ_INVENTORY_IMPORTS_VIEW=
BQ_INVENTORY_IMPORT_ROWS_VIEW=

# Global hyperlocal expiry reminders (source default: 60 seconds).
# Valid range: 5000–300000 ms. Expiry timestamps use BUSINESS_TIMEZONE.
HL_EXPIRY_POLL_INTERVAL_MS=60000

# Express/hyperlocal fulfilment (legacy POSAdmin/settings.py:453-595). Expiry is processed only
# when a progress page is viewed (job order.tasks.auto_reject_timed_out_for_store); no timer.
HL_POLL_INTERVAL_MS=100000
HL_PAGE_SIZE=20
HL_REJECT_LOCK_TTL_SECONDS=300
HL_TIMED_OUT_REASON_ID=5
OFD_ORDER_STATUS_ID=26
VINC_ALLOCATED_STATUSES=Allocated,Part Allocated
EXPRESS_ORDER_API_KEY=
PREORDER_URL=
PREORDER_INTERNAL_KEY=
# API-v2 app credentials (legacy Ar_app_id / Ar_app_key) for check-user-exclusive customer
# lookup (users/views.py:612-664). Unset: customer lookup answers 503.
API_V2_APP_ID=
API_V2_APP_KEY=

# Foreground day-close reminder snooze (source default: 10 minutes).
DAY_CLOSE_NAG_INTERVAL_MINUTES=10

# Whole-order STORE fulfillment status requests (legacy posts to the sync API).
WHOLE_ORDER_STATUS_CONTRACT=
BACKEND_SYNC_API_BASE_URL=
BACKEND_SYNC_REPO_API_KEY=
WHOLE_ORDER_STATUS_RECEIPT_KEY=
WHOLE_ORDER_STATUS_WORKER_ENABLED=false
WHOLE_ORDER_STATUS_HTTP_TIMEOUT_MS=10000
WHOLE_ORDER_STATUS_CLAIM_TIMEOUT_MS=300000

# Private media: exact bucket origins must also be allowed by frontend POS_MEDIA_ORIGINS.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_ENDPOINT_URL=
AWS_S3_KMS_KEY_ID=
AWS_S3_EXPECTED_BUCKET_OWNER=
AWS_S3_PRESIGNED_URL_EXPIRY=900
# Existing API service; never the legacy Django UI server.
TSS_API_BASE_URL=
TSS_API_MIGRATION_V2=true
# Checkout/returns/payments state (W4) uses REDIS_URL above (rediss://, noeviction).
# Legacy checkout flags (backend/parity/legacy-flags.md); unset = legacy default.
# GLOBAL_SHOW_COUPON_MODULE=1
# GLOBAL_SHOW_PG_DISCOUNT_MODULE=1
# ENABLE_OLD_PG_DISCOUNT=1
# ENABLE_NEW_PG_DISCOUNT=1
# ENABLE_VOUCHER_TO_MONEY_CHECK_AND_COVERT=0
# TEN_PER_SWITCH=1
# EXCHANGE_ENABLED_STORE_IDS=1
# Header-only invoice authentication and purpose-only feedback proofs; review upstream candidates.
TSS_POS_INVOICE_KEY=
UPSTREAM_POS_INVOICE_CONTRACT=
# Protected online invoice reader; exact private /internal/pos/invoices/online URL.
TSS_ONLINE_INVOICE_URL=
# Private same-day/Express invoice readers; enable after scoped producer qualification.
TSS_SDD_INVOICE_URL=
TSS_EXPRESS_INVOICE_URL=
UPSTREAM_POS_SCOPED_INVOICE_CONTRACT=
# Genuine paid N invoices use explicit global-online access. Enable
# pos-global-online-invoice-v1 only after the private consumer accepts its
# contextStoreId/ownerStoreId:null, native/history and source-issuer proof.
# SDD additionally requires the scoped-contract acknowledgement above.
UPSTREAM_POS_GLOBAL_ONLINE_INVOICE_CONTRACT=
# Online invoice lifetime counts use explicitly published BigQuery facts/manifests.
UPSTREAM_POS_INVOICE_HISTORY_CONTRACT=
INVOICE_HISTORY_PUBLICATION_CONTRACT=
BQ_INVOICE_HISTORY_ORDERS_VIEW=
BQ_INVOICE_HISTORY_CUSTOMERS_VIEW=
BQ_INVOICE_HISTORY_PUBLICATIONS_VIEW=
INVOICE_HISTORY_MAX_LAG_SECONDS=
# One-use customer website sign-in; enable only after receiver qualification.
CUSTOMER_WEBSITE_HANDOFF_ENABLED=false
CUSTOMER_WEBSITE_HANDOFF_CONTRACT=
CUSTOMER_WEBSITE_HANDOFF_RECEIVER_URL=
CUSTOMER_WEBSITE_HANDOFF_SERVICE_KEY=
CUSTOMER_WEBSITE_HANDOFF_TTL_SECONDS=60
CUSTOMER_WEBSITE_HANDOFF_SESSION_SECONDS=300
# Purpose-only order-message bridge; never reuse invoice/customer-token keys.
UPSTREAM_POS_FEEDBACK_PROOF_CONTRACT=
# Source-pinned current-schema replacement for stock CALLs; review parity/stock-projection.md.
# Leave empty until this explicit contract is selected for the verified writer schema.
POS_STOCK_PROJECTION_CONTRACT=
# Separate source actor0 contract for authenticated, durable internal jobs only.
POS_SYSTEM_STOCK_PROJECTION_CONTRACT=
# Source local-delivery operations; the worker remains disabled until every adapter is accepted.
LEGACY_DELIVERY_MOVEMENT_CONTRACT=
LEGACY_DELIVERY_WORKER_ENABLED=false
LEGACY_DELIVERY_WORKER_INTERVAL_MS=1000
LEGACY_DELIVERY_WORKER_BATCH_SIZE=20
LEGACY_DELIVERY_HTTP_TIMEOUT_MS=15000
LEGACY_DELIVERY_RECONCILIATION_URL=
LEGACY_DELIVERY_RECONCILIATION_KEY=
APP_ID=
APP_KEY=
TSS_OBERVER_URL=
TSS_OBERVER_APP_ID=
TSS_OBERVER_APP_KEY=
MAIN_API_V2_URL=
MJML_HOST=
ORDER_PRODUCER_URL=
ORDER_PRODUCER_APP_ID=
ORDER_PRODUCER_APP_KEY=
SLACK_URL=
COMMON_GROUP_ALERT_ON=false
BAMBOO_TOOTHBRUSH_EM=
WELCOME_NOTE_PRODUCT_ID=
HYPERLOCAL_CUT_OFF_SWITCH=true
HYPERLOCAL_CUT_OFF_TIME=17:00
# Store-form Slack connect (legacy settings); unset id/secret = "Slack app is not configured".
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_OAUTH_REDIRECT_URI=

# Read-only historical permission activity; deploy the reviewed view and source matching UDF.
BQ_SPECIAL_PERMISSION_ACTIVITY_VIEW=
BQ_SPECIAL_PERMISSION_ACTIVITY_MATCH_UDF=

# Model history needs an accepted source/actor binding; table visibility alone is insufficient.
POS_ADMINISTRATION_HISTORY_MYSQL_CONTRACT=
POS_ADMINISTRATION_HISTORY_MYSQL_ACTOR=
BQ_ADMINISTRATION_HISTORY_VIEW=
BQ_ADMINISTRATION_HISTORY_MATCH_UDF=
BQ_ADMINISTRATION_HISTORY_CONTRACT=


# Private, contact-first customer briefing service; historical reads require BigQuery proof.
CUSTOMER_CONTACTS_ENABLED=false
CUSTOMER_CONTACTS_CONTRACT=
CUSTOMER_CONTACTS_SECRET=
CUSTOMER_REGISTRATION_SECRET=
RESEND_COUNT=6
VERIFICATION_COUNT=3
CHANGE_MOBILE_OTP_EXPIRY_IN_SEC=600
CUSTOMER_CONTACTS_WORKER_ENABLED=false
CUSTOMER_CONTACTS_WORKER_INTERVAL_MS=2000
CUSTOMER_CONTACTS_WORKER_LEASE_MS=60000
CUSTOMER_CONTACT_SMS_TEMPLATE=
# Customer OTP is sent and verified by API-v2 omnichannel-sendotp/verifyotp (legacy).
CUSTOMER_OTP_SENDS_PER_DAY=6
CUSTOMER_OTP_FAILURES_PER_WINDOW=5
REDIS_VERIFIED_USER_OBJECT_EXPIRY=900
STAGING_CMS_ENDPOINT=
# Historical customer facts stay in BigQuery. Deploy the reviewed bucket layout before activation.
BQ_CUSTOMER_HISTORY_LAYOUT=raw
BQ_CUSTOMER_HISTORY_ORDERS_TABLE=
BQ_CUSTOMER_HISTORY_ORDER_STORES_TABLE=
BQ_CUSTOMER_HISTORY_LINES_TABLE=
BQ_CUSTOMER_HISTORY_PRODUCTS_TABLE=
BQ_CUSTOMER_HISTORY_FEEDBACK_TABLE=
CUSTOMER_INSIGHTS_ENABLED=false
CUSTOMER_INSIGHT_URL=
CUSTOMER_INSIGHT_API_KEY=
CUSTOMER_INSIGHT_QUERY_CONTRACT=
CUSTOMER_INSIGHT_STORE_IDS=
CUSTOMER_INSIGHT_IMAGE_ORIGINS=https://prod-img.thesouledstore.com

# Gift-card batch generation (legacy core.tasks.generate_and_upload_gift_card), run by
# worker:jobs as pos.gift_card_batches.generate. Uses AWS_STORAGE_BUCKET_NAME and NETCORE_*.
GC_SALTKEY=
GIFT_CARD_BATCH_DELIVERY_TIMEOUT_MS=30000

# Legacy staff mPOS download (APP_APK_URL is streamed after a one-time activation) and
# customer-app QR (MAIN_SITE_API_V2 + firebase-dynamic-link; redirects limited to the origins).
APP_APK_URL=
MPOS_DOWNLOAD_QR_EXP_SEC=60
MPOS_DOWNLOAD_LINK_EXP=60
MAIN_SITE_API_V2=
POS_CUSTOMER_APP_ORIGINS=https://www.thesouledstore.com
POS_APP_REDIRECT=https://www.thesouledstore.com

# Historical public order browsing and order-copy source facts. Enable only after
# complete, bounded publication/CDC acceptance; never fall back to old MySQL facts.
ORDER_HISTORY_CONTRACT=
BQ_ORDER_HISTORY_HEADERS_VIEW=
BQ_ORDER_HISTORY_STORES_VIEW=
BQ_ORDER_HISTORY_LINES_VIEW=
BQ_ORDER_HISTORY_PUBLICATIONS_VIEW=
ORDER_HISTORY_MAX_LAG_SECONDS=300
ORDER_HISTORY_MAX_ORDER_LINES=10000

# Rich N/HL/HE detail facts require the independent
# pos-source-online-order-detail-v1 publication contract. Fully qualified views;
# leave disabled until complete generation/hash/count/CDC acceptance. Current
# customer/product dimensions remain authorized PRIMARY reads, never old facts.
ORDER_DETAIL_CONTRACT=
BQ_ORDER_DETAIL_FACTS_VIEW=
BQ_ORDER_DETAIL_PUBLICATIONS_VIEW=
ORDER_DETAIL_MAX_LAG_SECONDS=300

# Store creation resolves these source contact identities inside its writer
# transaction. Exact comma-separated email tokens, without surrounding spaces.
# Explicit blank means no default operators; remove this variable to keep store
# creation unavailable until configuration is supplied. Never use login emails
# or the current actor as a substitute for the configured contact identities.
STOREDEFAULTUSER=

# Three-column parent/store assignment import history; independent from stock imports.
BQ_PARENT_STORE_IMPORTS_VIEW=
BQ_PARENT_STORE_IMPORT_ROWS_VIEW=

# Full source order-list filters, formatter and queue history. The private
# comparison key and its ID must match the independently qualified publication.
ORDER_SEARCH_CONTRACT=
BQ_ORDER_SEARCH_INDEX_VIEW=
BQ_ORDER_SEARCH_FACTS_VIEW=
BQ_ORDER_SEARCH_PUBLICATIONS_VIEW=
ORDER_SEARCH_CONTACT_KEY=
ORDER_SEARCH_CONTACT_KEY_ID=
ORDER_SEARCH_MAX_LAG_SECONDS=300
ORDER_SEARCH_MAX_INDEX_ROWS=20000
ORDER_SEARCH_MAX_QUEUE_ORDERS=10000

# Audited ordinary-cash corrections. Select both contracts only after native
# finance and historical publication acceptance. Keep the V1 proof key for reads
# after writes are disabled; it is independent from session/JWT rotation.
POS_PAYMENT_CORRECTION_PROOF_KEY_V1=
BQ_PAYMENT_CORRECTION_PUBLICATIONS_TABLE=

# Ecommerce threshold projection and authenticated full catalog completion.
# This also requires the separately selected system stock projection contract.
ECOMMERCE_FULL_SYNC_CONTRACT=
ECOMMERCE_FULL_SYNC_URL=
ECOMMERCE_FULL_SYNC_SECRET=
ECOMMERCE_FULL_SYNC_TIMEOUT_MS=5000
ECOMMERCE_SYNC_BATCH_SIZE=25
ECOMMERCE_SYNC_MAX_PRODUCTS=50000


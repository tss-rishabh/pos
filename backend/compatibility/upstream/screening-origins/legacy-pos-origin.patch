+"""Selected-only original legacy authority/nonce hooks."""
+import os
+import sys
+from pathlib import Path
+def selected():return os.environ.get('POS_SCREENING_ORIGIN_CONTRACT')=='pos-screening-origins-v1'
+def modules():
+    root=Path(os.environ['POS_NODE_SCREENING_MODULE_ROOT']).resolve()
+    for name in ('public-screening-writer','screening-origins'):sys.path.insert(0,str(root/name))
+def install(namespace):
+    if selected():
+        modules()
+        from legacy_execution import install as apply
+        apply(namespace)
+def authenticated_mpos(request,response,user):
+    if not selected():return response
+    modules()
+    from legacy_staff import after_mpos_authentication
+    return after_mpos_authentication(request,response,user)
+def revoke(actor_id):
+    if selected():
+        modules()
+        from legacy_staff import revoke_actor
+        revoke_actor(actor_id)
+def order_headers(*args,**kwargs):
+    if not selected():return {}
+    modules()
+    from legacy_client import headers
+    return headers(*args,**kwargs)
+def original_response(*args,**kwargs):
+    modules()
+    from legacy_client import response
+    return response(*args,**kwargs)
+def command_created(*args):
+    if selected():
+        modules()
+        from legacy_execution import command_created as created
+        return created(*args)
+def payment(request,token,body,url):
+    if not selected():
+        import requests
+        return requests.post(url,json=body,headers={'Content-Type':'application/json','Authorization':token})
+    modules()
+    from legacy_client import payment as submit
+    return submit(request,token,body,url)

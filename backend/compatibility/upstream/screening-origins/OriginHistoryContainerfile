# Build from backend/. Capture needs the reviewed Python API dependencies;
# the ordinary backend runtime image supplies only Node and is insufficient.
ARG ORIGIN_HISTORY_CAPTURE_DEPENDENCY_IMAGE
FROM node:24.22.3-bookworm-slim@sha256:dc26ae92c9fb15cf6b1d63e20f0944b2efe0f115b20e00be48fb23fceb061c54 AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY tsconfig.json ./
COPY src ./src
COPY compatibility/upstream/whole-order-status ./compatibility/upstream/whole-order-status
RUN npm run build

FROM node:24.22.3-bookworm-slim@sha256:dc26ae92c9fb15cf6b1d63e20f0944b2efe0f115b20e00be48fb23fceb061c54 AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force

FROM ${ORIGIN_HISTORY_CAPTURE_DEPENDENCY_IMAGE} AS origin-history-publisher
ARG ORIGIN_HISTORY_CAPTURE_DEPENDENCY_IMAGE
RUN python3 -c 'import os,re; raise SystemExit(0 if re.fullmatch(r"[^\s]+@sha256:[a-f0-9]{64}", os.environ["ORIGIN_HISTORY_CAPTURE_DEPENDENCY_IMAGE"]) else "Pinned capture dependency image required")'
# Fail the image build if its reviewed Python dependencies or the copied Node
# runtime cannot load on the chosen architecture/libc. No source app is loaded.
COPY --from=build /usr/local/bin/node /usr/local/bin/node
RUN node -e 'if(process.version!=="v24.22.3")process.exit(1)' && python3 -c 'import sqlalchemy,pymysql,cryptography'
WORKDIR /app
COPY package.json ./
COPY --from=build --chown=65532:65532 /app/dist ./dist
COPY --from=dependencies --chown=65532:65532 /app/node_modules ./node_modules
COPY --chown=65532:65532 compatibility/upstream/legacy-order-imports/*.py /opt/pos-source-adapters/legacy-order-imports/
COPY --chown=65532:65532 compatibility/upstream/legacy-order-imports/*.json /opt/pos-source-adapters/legacy-order-imports/
COPY --chown=65532:65532 compatibility/upstream/legacy-order-imports/benefit-profile/*.py /opt/pos-source-adapters/legacy-order-imports/benefit-profile/
COPY --chown=65532:65532 compatibility/upstream/legacy-order-imports/benefit-profile/*.json /opt/pos-source-adapters/legacy-order-imports/benefit-profile/
COPY --chown=65532:65532 compatibility/upstream/public-screening-writer/*.py /opt/pos-source-adapters/public-screening-writer/
COPY --chown=65532:65532 compatibility/upstream/public-screening-writer/*.json /opt/pos-source-adapters/public-screening-writer/
COPY --chown=65532:65532 compatibility/upstream/screening-origins/*.py /opt/pos-source-adapters/screening-origins/
COPY --chown=65532:65532 compatibility/upstream/screening-origins/*.sql /opt/pos-source-adapters/screening-origins/
COPY --chown=65532:65532 compatibility/upstream/screening-origins/*.json /opt/pos-source-adapters/screening-origins/
COPY --chown=65532:65532 --chmod=0555 compatibility/upstream/screening-origins/capture-python.sh /opt/pos-source-adapters/capture-python
ENV NODE_ENV=production PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/pos-source-adapters/legacy-order-imports:/opt/pos-source-adapters/legacy-order-imports/benefit-profile:/opt/pos-source-adapters/public-screening-writer:/opt/pos-source-adapters/screening-origins \
    POS_SCREENING_ORIGIN_HISTORY_SOURCE_PYTHON=/opt/pos-source-adapters/capture-python \
    POS_SCREENING_ORIGIN_HISTORY_SOURCE_MODULE=/opt/pos-source-adapters/screening-origins/history_capture.py \
    POS_SCREENING_ORIGIN_HISTORY_PUBLISHER_ENABLED=false
USER 65532:65532
HEALTHCHECK NONE
STOPSIGNAL SIGTERM
ENTRYPOINT []
CMD ["node","dist/modules/screening-origins/history-generation-worker-main.js"]

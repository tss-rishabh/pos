+def do_tss_hacks_pos(context, pos_shop_invoice=False):
+    order = context['order']
+    items = context['has_products']
+    gift_vouchers = context['gift_vouchers']
+    is_split = context.get('is_split', False)
+
+    split_coupon_discount = 0
+    split_tss_points = 0
+    split_gift_voucher = 0
+    split_tss_money = 0
+
+    if (order.pay_amt - math.floor(order.pay_amt)) > 0:
+        total_amt = order.pay_amt
+        rounding_off = order.pay_amt - math.floor(order.pay_amt)
+        order.pay_amt = math.floor(order.pay_amt)
+    else:
+        total_amt = order.pay_amt + (order.fraction_value or 0)
+        rounding_off = order.fraction_value or 0
+
+    additional = {
+        'total_taxable': 0,
+        'cgst': 0,
+        'sgst': 0,
+        'igst': 0,
+        'subtotal': 0,
+        'charges': int((order.cod_charges or 0) + (order.gifting_charges or 0) + (order.shipping_amt or 0)),
+        'cod_charges': int(order.cod_charges or 0),
+        'gifting_charges': int(order.gifting_charges or 0),
+        'shipping_amt': int(order.shipping_amt or 0),
+        'amount_words': num2words(math.floor(order.pay_amt)),
+        'state_gst_code': get_zone_code(order),
+        'courier': get_courier_name(order),
+        'payment_method': get_payment_method(order),
+        'rounding_off': -round(rounding_off, 2),
+        'total_amt': total_amt,
+        'cart_total':0,
+        'invoice_total' : 0,
+        'total_savings': 0,
+        'member_savings': 0
+    }
+    total_payable = 0
+    for item in gift_vouchers:
+        additional['subtotal'] += item['voucher_initial_value']
+
+    total_items = 0
+    gst_dict = {}
+
+    for item in items:
+        # item['taxable_price'] = item['price'] - (item.get('store_disc_pg', 0) or 0) - item.get('disc', 0) - (item.get('hp_tss_points_used', 0) or 0) - (item.get('wallet_disc', 0) or 0) - (item.get('voucher_disc', 0) or 0)
+        additional['cart_total'] += item["price"]
+        total_items += int(item["qty"])
+
+        line_price = float(item["price"]) / float(item["qty"])
+        item["line_price"] = round(line_price, 2)
+        item["item_price"] = item["price"]
+
+        if item['category'] == 'T-Shirt Dresses':
+            item['category'] = 'Dresses'
+            
+        # item['taxable_price'] = round(item['taxable_price']/(1+(item['gst']/100)),2)
+        
+        additional['total_taxable'] += float(item['pre_gst_amt'] or 0)
+        additional['subtotal'] += additional['total_taxable']
+        if not item['hsn']:
+            item['hsn'] = '-'
+
+        # GST Calculation
+        item['sgst_r'] = item['cgst_r'] = item['gst'] / 2
+
+        item['cgst'] = (item['cgst_r'] / 100) * float(item['pre_gst_amt'])
+        item['sgst'] = (item['sgst_r'] / 100) * float(item['pre_gst_amt'])
+        
+        additional['cgst'] += item['cgst']
+        additional['sgst'] += item['sgst']
+
+        item['cgst'] = round(item['cgst'], 2)
+        item['sgst'] = round(item['sgst'], 2)
+        if pos_shop_invoice:
+
+            gst_key = str(item['gst'] / 2)
+
+            if gst_key not in gst_dict:
+                gst_dict[gst_key] = {"cgst": 0, "sgst": 0}
+
+            cgst_r = (item['cgst_r'] / 100) * float(item['pre_gst_amt'])
+            sgst_r = (item['sgst_r'] / 100) * float(item['pre_gst_amt'])
+
+            cgst = round(gst_dict[gst_key]["cgst"] + cgst_r, 2)
+            sgst = round(gst_dict[gst_key]["sgst"] + sgst_r, 2)
+
+            gst_dict[gst_key] = {"cgst": cgst, "sgst": sgst}
+            additional['total_savings'] += round(((item.get('normal_price') - item['price']) + item['disc']), 2) if item.get('normal_price') > 0 else 0
+            additional['member_savings'] += round(item.get('exclusive_saving', 0), 2)
+            logger.debug(f"exclsive_saving for item {item['prod_id']} is {item.get('exclusive_saving', 0)}")
+           
+        
+
+        if is_split:
+            split_coupon_discount += item.get('disc') or 0
+            split_tss_points += item.get('hp_tss_points_used') or 0

+def mask_phone(phone: str, show_start: int = 2, show_end: int = 2, mask_char: str = '*') -> str:
+    """
+    Mask a phone number by hiding middle digits.
+
+    Keeps the first `show_start` digits and the last `show_end` digits visible,
+    replacing the remaining digits with `mask_char`.
+
+    Args:
+        phone (str): Phone number to be masked.
+        show_start (int, optional): Number of digits to keep visible at the start. Defaults to 2.
+        show_end (int, optional): Number of digits to keep visible at the end. Defaults to 2.
+        mask_char (str, optional): Character used for masking. Defaults to '*'.
+
+    Returns:
+        str: Masked phone number. If the phone number length is too short
+             to apply masking, the original value is returned.
+
+    Example:
+        >>> mask_phone("9876543210")
+        '98******10'
+        >>> mask_phone("9876543210", show_start=3, show_end=3)
+        '987****210'
+    """
+    phone = str(phone)
+    if len(phone) <= show_start + show_end:
+        return phone  # nothing to mask
+
+    masked_len = len(phone) - (show_start + show_end)
+    return phone[:show_start] + (mask_char * masked_len) + phone[-show_end:]
+

+        additional["store_short_name"] = store_obj.short_name
+        additional["store_category"] = store_obj.category
+    else:
+        additional["address"] = ""
+        additional["gstin"] = ""
+        additional["gst_arn"] = ""
+        additional["email"] = ""
+        additional["phone"] = ""
+        additional["store_name"] = ""
+        additional["store_short_name"] = ""
+        additional["store_category"] = ""
+
+    additional["store_cin"] = store_cin
+
+    if order_store_obj:
+
+        additional["cash"] = order_store_obj.offline_payment
+        additional["cash_recieved"] = order_store_obj.offline_payment_recieved
+        additional["change"] = 0
+
+        if order_store_obj.offline_payment and order_store_obj.offline_payment > 0:
+            if order_store_obj.offline_payment_recieved and order_store_obj.offline_payment_recieved > 0:
+                additional["change"] = (
+                    order_store_obj.offline_payment_recieved - order_store_obj.offline_payment

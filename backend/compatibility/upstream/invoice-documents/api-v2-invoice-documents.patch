+def validate(auth_header, order_id):
+    options = {
+        'verify_aud': False,
+        'require_sub': False,
+        'verify_iat': False
+    }
+
+    if not auth_header:
+        raise Exception('Please provide token')
+
+    try:
+        # Handle 2FA token
+        if auth_header.startswith("2f."):
+            auth_header = auth_header[3:]
+            token = jwt.decode(
+                auth_header,
+                settings.SECRET_KEY_512,
+                algorithms=['HS512'],
+                options=options
+            )
+        else:
+            token = jwt.decode(
+                auth_header,
+                settings.SECRET_KEY,
+                algorithms=['HS256'],
+                options=options
+            )
+
+        user_id = int(token.get('sub'))
+
+        query = text("""
+            SELECT id, user_id
+            FROM orders
+            WHERE id = :order_id
+              AND user_id = :user_id
+            LIMIT 1
+        """)
+
+        order = SessionR.execute(query,{"order_id": order_id, "user_id": user_id}).mappings().first()
+
+        if not order:
+            raise Exception('You are not authorized for this invoice')
+
+        return token

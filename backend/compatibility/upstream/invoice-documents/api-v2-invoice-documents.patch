+
+        additional["online"] = order_store_obj.online_payment
+        additional["others"] = order_store_obj.online_other_payment
+    else:
+        additional["cash"] = 0
+        additional["cash_recieved"] = 0
+        additional["change"] = 0
+        additional["online"] = 0
+        additional["others"] = 0

+def group_invoice_items(rows):
+    """
+    Groups invoice line items by product to handle split rows (qty=1).
+    Aggregates quantities and financial totals.
+    """
+    aggregated_data = {}
+
+    for row in rows:
+        # Create a unique key for grouping (Product + Custom Text + Status group + Warehouse)
+        # We must include fields that if different, should result in a separate line item.
+        key = (
+            row['prod_id'], 
+            row['sub_prod_id'],
+            row.get('custom_text', ''),
+            row.get('wc', ''), # Warehouse code might differ?
+            row.get('gift_voucher', ''),
+        )
+        
+        if key in aggregated_data:
+            existing = aggregated_data[key]
+            
+            # Aggregate integers/floats
+            existing['qty'] += row['qty']
+            existing['price'] += row['price']
+            existing['disc'] += row['disc']
+            
+            # Handle potential None values for aggregates
+            existing['hp_tss_points_used'] = (existing.get('hp_tss_points_used') or 0) + (row.get('hp_tss_points_used') or 0)
+            existing['wallet_disc'] = (existing.get('wallet_disc') or 0) + (row.get('wallet_disc') or 0)
+            existing['voucher_disc'] = (existing.get('voucher_disc') or 0) + (row.get('voucher_disc') or 0)
+            existing['store_disc_pg'] = (existing.get('store_disc_pg') or 0) + (row.get('store_disc_pg') or 0)
+            existing['pre_gst_amt'] = (existing.get('pre_gst_amt') or 0) + (row.get('pre_gst_amt') or 0)
+            existing['exclusive_saving'] = (existing.get('exclusive_saving') or 0) + (row.get('exclusive_saving') or 0)
+            
+            # Aggregate price fields if they exist (for reference, though main price is aggregation of sold price)
+            if 'normal_price' in row and row['normal_price']:
+                existing['normal_price'] = (existing.get('normal_price') or 0) + row['normal_price']
+            if 'special_price' in row and row['special_price']:
+                existing['special_price'] = (existing.get('special_price') or 0) + row['special_price']
+            if 'exclusive_price' in row and row['exclusive_price']:
+                existing['exclusive_price'] = (existing.get('exclusive_price') or 0) + row['exclusive_price']
+
+            # Keep track of original IDs if needed (e.g. for debugging)
+            if 'row_ids' not in existing:
+                existing['row_ids'] = [existing['rowid']]
+            existing['row_ids'].append(row['rowid'])
+
+        else:
+            # Initialize potential None fields to 0 for consistency if they are going to be used in math later
+            if row.get('wallet_disc') is None: row['wallet_disc'] = 0
+            if row.get('voucher_disc') is None: row['voucher_disc'] = 0
+            if row.get('hp_tss_points_used') is None: row['hp_tss_points_used'] = 0
+            if row.get('store_disc_pg') is None: row['store_disc_pg'] = 0
+            
+            aggregated_data[key] = row
+
+    return list(aggregated_data.values())
+

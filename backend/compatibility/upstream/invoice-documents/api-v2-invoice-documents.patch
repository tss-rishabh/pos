+bind = "0.0.0.0:" + port
+wsgi_app = "pos_invoice_documents_factory:create_app()"
+workers = 2
+worker_class = "gthread"
+threads = 4
+timeout = 20
+graceful_timeout = 10
+keepalive = 5
+preload_app = False
+accesslog = None
+errorlog = "-"

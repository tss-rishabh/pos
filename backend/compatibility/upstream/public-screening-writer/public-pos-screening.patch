+"""Purpose-specific original customer/staff/system writer installation."""
+import os
+import sys
+from pathlib import Path
+_root=Path(os.environ['POS_NODE_SCREENING_MODULE_ROOT']).resolve()
+for name in ('legacy-order-imports','offline-cash-pricing','public-screening-writer','screening-origins'):sys.path.insert(0,str(_root/name))
+def prepare(main_file):
+    if not os.environ.get('POS_SCREENING_ORIGIN_CONTRACT'):return
+    from origin_delivery import prepare as early
+    early(main_file)
+def install():
+    from origin_bootstrap import OriginBootstrap
+    return OriginBootstrap()

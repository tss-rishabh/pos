+sys.path.insert(0,str(_module_root/'legacy-order-imports'))
+sys.path.insert(0,str(_module_root/'offline-cash-pricing'))
+sys.path.insert(0,str(_module_root/'public-screening-writer'))
+from bootstrap import Bootstrap,after_validate
+def install(main_file):return Bootstrap(Path(main_file).resolve().parent)

# Build from backend/. Supply the reviewed original-source dependency image by
# immutable digest; this image packages owned adapters, never source credentials.
ARG SOURCE_DEPENDENCY_IMAGE
FROM ${SOURCE_DEPENDENCY_IMAGE} AS public-membership-cache-worker
ARG SOURCE_DEPENDENCY_IMAGE
RUN python3 -c 'import os,re; raise SystemExit(0 if re.fullmatch(r"[^\s]+@sha256:[a-f0-9]{64}", os.environ["SOURCE_DEPENDENCY_IMAGE"]) else "Pinned source dependency image required")'
WORKDIR /opt/pos-source-adapters
COPY --chown=65532:65532 compatibility/upstream/legacy-order-imports/*.py ./legacy-order-imports/
COPY --chown=65532:65532 compatibility/upstream/legacy-order-imports/*.json ./legacy-order-imports/
COPY --chown=65532:65532 compatibility/upstream/legacy-order-imports/benefit-profile/*.py ./legacy-order-imports/benefit-profile/
COPY --chown=65532:65532 compatibility/upstream/legacy-order-imports/benefit-profile/*.json ./legacy-order-imports/benefit-profile/
COPY --chown=65532:65532 compatibility/upstream/public-screening-writer/*.py ./public-screening-writer/
COPY --chown=65532:65532 compatibility/upstream/public-screening-writer/*.json ./public-screening-writer/
COPY --chown=65532:65532 compatibility/upstream/screening-origins/*.py ./screening-origins/
COPY --chown=65532:65532 compatibility/upstream/screening-origins/*.json ./screening-origins/
COPY --chown=65532:65532 compatibility/upstream/screening-origins/*.sql ./screening-origins/
COPY --chown=65532:65532 compatibility/upstream/screening-origins/*.mjs ./screening-origins/
COPY --chown=65532:65532 compatibility/upstream/offline-cash-pricing/*.py ./offline-cash-pricing/
COPY --chown=65532:65532 compatibility/upstream/offline-cash-pricing/patches/*.patch ./offline-cash-pricing/patches/
COPY --chown=65532:65532 compatibility/upstream/pending-cancellation/membership_provenance.py ./pending-cancellation/
COPY --chown=65532:65532 compatibility/upstream/pending-cancellation/membership_fence_contract.py ./pending-cancellation/
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PYTHONPATH=/opt/pos-source-adapters/legacy-order-imports:/opt/pos-source-adapters/legacy-order-imports/benefit-profile:/opt/pos-source-adapters/public-screening-writer:/opt/pos-source-adapters/offline-cash-pricing \
    POS_LEGACY_IMPORT_SOURCE_ROOT=/opt/pos-original-source \
    POS_LEGACY_IMPORT_RUNTIME_ROOT=/opt/pos-original-source \
    POS_PUBLIC_SCREENING_MEMBERSHIP_WORKER_ENABLED=false
USER 65532:65532
HEALTHCHECK NONE
STOPSIGNAL SIGTERM
ENTRYPOINT []
CMD ["python3","/opt/pos-source-adapters/public-screening-writer/public_membership_worker.py"]

# Separate private WSGI receiver. The approved original dependency image already
# supplies Gunicorn; source Dockerfile at the pinned baseline uses this server.
FROM public-membership-cache-worker AS private-source-receiver
EXPOSE 4423
CMD ["python3","-m","gunicorn","--workers","1","--worker-class","sync","--bind","0.0.0.0:4423","--timeout","60","--access-logfile","/dev/null","--error-logfile","/dev/null","runtime:create_application()"]

# Separate queue supervisor. The original immutable API base and the composed
# public API candidate are mounted independently, never copied into this image.
FROM public-membership-cache-worker AS source-origin-worker
ENV POS_SCREENING_ORIGIN_SOURCE_WORKER_SOURCE_ROOT=/opt/pos-public-source \
    POS_SCREENING_ORIGIN_SOURCE_WORKER_ENABLED=false \
    POS_SCREENING_ORIGIN_SOURCE_WORKER_SYSTEM_ENABLED=false \
    POS_SCREENING_ORIGIN_SOURCE_WORKER_EFFECTS_ENABLED=false
CMD ["python3","/opt/pos-source-adapters/screening-origins/source_worker.py"]

FROM source-origin-worker AS source-origin-task-consumer
ENV POS_SCREENING_ORIGIN_EFFECT_CONSUMER_ENABLED=false POS_SCREENING_ORIGIN_EFFECT_CONSUMER_LANE=tasks
CMD ["python3","/opt/pos-source-adapters/screening-origins/effect_consumer_worker.py"]

FROM source-origin-task-consumer AS source-origin-abandon-consumer
ENV POS_SCREENING_ORIGIN_EFFECT_CONSUMER_LANE=abandon

# Keep the default target a disabled queue consumer.
FROM public-membership-cache-worker AS runtime

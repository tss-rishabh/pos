+		return err
+	}
+	if p.projection != nil && !sameScreeningProjection(p.projection, own) {
+		return ErrReview
+	}
+	var bought uint64
+	if err = tx.QueryRowContext(ctx, ScreeningCountSQL, p.user).Scan(&bought); err != nil {
+		return err

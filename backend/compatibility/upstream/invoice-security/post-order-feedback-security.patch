+        throw new Error();
+      origins.add(value);
+    }
+    if (origins.size !== originValues.length) throw new Error();
+    return {
+      verifier: feedbackVerifier({ keys, maxTtlSeconds: Number(ttl), forbiddenKeys }),
+      origins,
+    };
+  } catch {

+        payload = decode(encodedPayload);
+      if (
+        !isRecord(header) ||
+        !exactKeys(header, ['alg', 'typ', 'kid']) ||
+        header.alg !== 'HS256' ||
+        header.typ !== 'JWT' ||
+        !keyIdentifier(header.kid)

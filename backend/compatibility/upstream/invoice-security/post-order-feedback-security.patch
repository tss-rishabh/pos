+        signature.toString('base64url') !== encodedSignature ||
+        signature.length !== expected.length ||
+        !timingSafeEqual(signature, expected)
+      )
+        throw new FeedbackProofError();
+      if (
+        !isRecord(payload) ||
+        !exactKeys(payload, [
+          'v',
+          'iss',
+          'aud',
+          'purpose',
+          'type',
+          'order_id',
+          'iat',
+          'exp',
+          'jti',
+        ]) ||
+        payload.v !== 1 ||
+        payload.iss !== 'pos-invoice' ||
+        payload.aud !== 'tss-pos-feedback' ||
+        payload.purpose !== 'nps' ||
+        payload.type !== 'nps' ||
